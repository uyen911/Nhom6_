<body>
    <style>
        .chat-icon-list{
            display:grid;
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index:9999;
            width:max-content;
            height:max-content;
    
    
            padding:5px;
   
            row-gap:1rem;
        }
        .chat-icon {
    
            width: 50px !important;
            height: 50px !important;
    
            background-size: cover;
            background-position: center;
            border-radius: 50%;
            transition: 0.5s;
            margin:auto;
  
        }
        
        .chat-window {
            position: fixed;
            bottom: 20px;
            right: 100px;
            width: 300px;
            max-width: 100%;
          
            background-color: #fff;
            
            display: none;
            flex-direction: column;
            z-index:9999;
          
            box-shadow:0 0 5px #B197FC;
            border-radius:10px;
   
        }
       
        .chat-header {
            padding: 10px;
            background-color: #DDA0DD;
            color: white;
            text-align: center;
            
            border-top-left-radius:10px;
            border-top-right-radius:10px;
        }
        .chat-messages {
            padding: 10px;
            height: 300px;
            overflow-y: auto;
            display:block;
            overflow-x:hidden;
        }
        .chat-input {
            padding:5px;
            display: flex;
            border-bottom-left-radius: 10px;
            border-bottom-right-radius: 10px;
            background-color: black;
        }
        .chat-input input {
            flex: 1;
            padding:5px 10px ;
            border: 1px solid #ddd;
            border-bottom-left-radius: 5px;
            border-top-left-radius:5px;
            color:white;
            background-color:black;
        }
        .chat-input button i{
            color:#7a29c4;
        }
        .chat-input button {
            padding: 10px;
    
            border: none;
            background-color: #0000;
            color: #9b51e0 !important;
    
            border-bottom-right-radius: 5px;
            border-top-right-radius:5px;
            cursor: pointer;
        }
        .chat-input button:hover i{
    
            transform:scale(1.1);
        }
        .message {
            margin: 10px 0;
            padding: 5px 10px;
            border-radius: 5px;
            width:max-content;
            display:block;
            overflow-x:hidden;
            flex-wrap:wrap;
            max-width:90%;
        }
        .message.bot {
            text-align: left;
            background-color: #e9e9e9;
            color:black;
            display:block;
            border-top-left-radius: 0;
            flex-wrap:wrap
        }
        .message.user {
            text-align: right;
            background-color: #c2b3d3;
            color: black;
            margin-left: auto;
             border-top-right-radius: 0;
        }
        #user-input{
            width:100%;
            padding:5px;
            height:40px;
            color:white;
            background-color:black;
            border:none;
        }
      
        .a-chatbot-link p{
            color:#000; text-align:left;
            padding:0 10px;
            background:#eee;
        }
        .a-chatbot-link{
            margin-top:-10px;
            margin-bottom:-10px;
        }
      
        
     
       
      
      
   
        
        
       

        
    </style>
        <%---------- ChatBot - JpopSTORE ----------%>


    <div id="listIconChat" class="chat-icon-list">
    

    
    
    <a title="Chat với ChatBot"  id="btnChatBot" class="chat-icon" onclick="toggleChatWindow()">

        <img id="img-icon-chatbot" class="img-icon-chatbot" style="width:100%; object-fit:cover;" src="data:image/png;base64,"/>

    </a>
    </div>
   
    <div class="chat-window" id="chat-window">
        <div class="chat-header">
            <p>Chatbot</p>
           

        </div>
        
        <div class="chat-messages" id="chat-messages">
            
        </div>
        
        <div class="chat-input">

            <textarea id="user-input" placeholder="Nội dung tin nhắn..."></textarea>

            <button onclick="sendMessage(document.getElementById('user-input').value)"><i class="fas fa-paper-plane"></i></button>
        </div>
    </div>

