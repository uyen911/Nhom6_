 <script>

     window.onload = function () {
         clearMessages();
     };
     function clearMessages() {
         const message = document.querySelectorAll('.message');
         const parent = messages[0].parentNode;

         // Duyệt qua từng thẻ trong messages
         for (let i = 0; i < messages.length; i++) {
             // Xóa từng thẻ bằng cách gọi removeChild trên parentNode
             parent.removeChild(messages[i]);
         }

     }

     function loadStoredMessages() {


         const message = document.querySelectorAll('.message');
         const storedMessages = JSON.parse(localStorage.getItem('chatMessages')) || [];
         storedMessages.forEach(({ text, type, src, link, sender }) => {
             if (text != null && message.length == 0) {
                 document.getElementById('clearChatButton').style.display = 'block';
             }
             if (sender === 'user' && message.length == 0 && text != null) {
                 addMessage(text, 'user');
             }
             else if (sender === 'bot' && message.length == 0) {
                 if (text != null)
                     addMessage(text, 'bot');
                 if (type === 'image' && src != null) {
                     addMessageImg(src, sender);
                 }
                 if (type === 'link' && link != null) {
                     addMessageLink(link, sender);
                 }
             }

         });
     }

     const chatWindow = document.getElementById('chat-window');
     const chatMessages = document.getElementById('chat-messages');
     const userInput = document.getElementById('user-input');
     const iconchat = document.getElementById('img-icon-chatbot');
     const zaloChat = document.getElementById('zaloChat');
     const messengerChat = document.getElementById('messengerChat');
     const iconListChat = document.getElementById('listIconChat');
     function toggleChatWindow() {

         
         chatWindow.style.animationName = chatWindow.style.display === 'none' || chatWindow.style.display === '' ? 'slideUp' : 'slideDownOut'

         setTimeout(function () {
             chatWindow.style.display = chatWindow.style.display === 'none' || chatWindow.style.display === '' ? 'flex' : 'none';
             
             if (chatWindow.style.display === 'flex') {

                 loadStoredMessages();
             }
             else {
                 clearMessages();
             }
         }, 400);

     }

     //function addMessage(message, sender) {
     //    const messageDiv = document.createElement('div');
     //    messageDiv.classList.add('message', sender);
     //    messageDiv.textContent = message;
     //    chatMessages.appendChild(messageDiv);
     //    const messages = JSON.parse(localStorage.getItem('chatMessages')) || [];
     //    messages.push({ text: message, sender: sender });
     //    localStorage.setItem('chatMessages', JSON.stringify(messages));

     //    chatMessages.scrollTop = chatMessages.scrollHeight;
     //}

     function addMessage(message, sender) {
         const messageDiv = document.createElement('div');
         messageDiv.classList.add('message', sender);
         messageDiv.textContent = message;
         chatMessages.appendChild(messageDiv);

         // Lấy tất cả các tin nhắn từ localStorage
         const messages = JSON.parse(localStorage.getItem('chatMessages')) || [];

         // Kiểm tra xem tin nhắn sắp được thêm có tồn tại trong mảng messages chưa
         const existingMessageIndex = messages.findIndex(msg => msg.text === message && msg.sender === sender);

         // Nếu không tìm thấy tin nhắn tồn tại, thêm tin nhắn mới vào mảng
         if (existingMessageIndex === -1) {
             messages.push({ text: message, sender: sender });
             localStorage.setItem('chatMessages', JSON.stringify(messages));
         }

         chatMessages.scrollTop = chatMessages.scrollHeight;
     }


     //function addMessageImg(imgsrc, sender) {

     //    const img = document.createElement('img');
     //    img.classList.add('message', sender);
     //    img.src = imgsrc;
     //    img.style.height = '180px';
     //    img.style.width = 'auto';
     //    img.style.objectFit = 'contain';
     //    img.style.borderRadius = '10px';
     //    chatMessages.appendChild(img);

     //    const messages = JSON.parse(localStorage.getItem('chatMessages')) || [];
     //    messages.push({ type: 'image', src: imgsrc, sender: sender });
     //    localStorage.setItem('chatMessages', JSON.stringify(messages));

     //    chatMessages.scrollTop = chatMessages.scrollHeight;


     //}
     let messageCount = 0; // Initialize a counter outside the function

     //function addMessageImg(imgsrc, sender) {
     //    const alinkIMG = document.createElement('a');
     //    alinkIMG.classList.add('message', sender);
     //    alinkIMG.style.textDecorationLine = 'none';
     //    alinkIMG.dataset.fancybox = "gallery"; // Setting the data attribute for Fancybox
     //    alinkIMG.dataset.type = "image"; // Specifying the type of media
     //    alinkIMG.dataset.fancyboxIndex = messageCount; // Assigning the current count as the index
     //    alinkIMG.style.objectFit = 'contain';
     //    alinkIMG.style.borderRadius = '10px'
     //    alinkIMG.style.height =  '180px';
     //    alinkIMG.href = imgsrc;

     //    const img = document.createElement('img');
     //    img.src = imgsrc;
     //    img.style.height = '100%';
     //    img.style.width = '100%';
     //    img.style.objectFit = 'contain';
     //    img.style.borderRadius = '10px';
     //    alinkIMG.appendChild(img); // Append the image to the anchor tag

     //    chatMessages.appendChild(alinkIMG); // Append the anchor tag to the chat messages container

     //    const messages = JSON.parse(localStorage.getItem('chatMessages')) || [];
     //    messages.push({ type: 'image', src: imgsrc, sender: sender, index: messageCount }); // Include the index in the message object
     //    localStorage.setItem('chatMessages', JSON.stringify(messages));

     //    messageCount++; // Increment the counter for the next message

     //    chatMessages.scrollTop = chatMessages.scrollHeight;
     //}

     function addMessageImg(imgsrc, sender) {
         const alinkIMG = document.createElement('a');
         alinkIMG.classList.add('message', sender);
         alinkIMG.style.textDecorationLine = 'none';
         alinkIMG.dataset.fancybox = "gallery";
         alinkIMG.dataset.type = "image";
         alinkIMG.dataset.fancyboxIndex = messageCount;
         alinkIMG.style.objectFit = 'contain';
         alinkIMG.style.borderRadius = '10px';
         alinkIMG.style.height = '180px';
         alinkIMG.href = imgsrc;

         const img = document.createElement('img');
         img.src = imgsrc;
         img.style.height = '100%';
         img.style.width = '100%';
         img.style.objectFit = 'contain';
         img.style.borderRadius = '10px';
         alinkIMG.appendChild(img);

         chatMessages.appendChild(alinkIMG);

         const messages = JSON.parse(localStorage.getItem('chatMessages')) || [];
         // Kiểm tra xem tin nhắn hình ảnh sắp được thêm có tồn tại trong mảng messages chưa
         const existingImageIndex = messages.findIndex(msg => msg.type === 'image' && msg.src === imgsrc && msg.sender === sender);

         // Nếu không tìm thấy tin nhắn hình ảnh tồn tại, thêm tin nhắn mới vào mảng
         if (existingImageIndex === -1) {
             messages.push({ type: 'image', src: imgsrc, sender: sender, index: messageCount });
             localStorage.setItem('chatMessages', JSON.stringify(messages));
         }

         messageCount++;

         chatMessages.scrollTop = chatMessages.scrollHeight;
     }


     //function addMessageLink(alink, sender) {


     //    const alinkitem = document.createElement('a');
     //    alinkitem.classList.add('message', sender);
     //    alinkitem.href = alink;
     //    alinkitem.textContent = 'Bấm vào đây để đi đến';
     //    alinkitem.style.padding = '10px';
     //    alinkitem.style.color = 'blue';
     //    alinkitem.style.textAlign = 'center';
     //    chatMessages.appendChild(alinkitem);

     //    const messages = JSON.parse(localStorage.getItem('chatMessages')) || [];
     //    messages.push({ type: 'link', link: alink, sender: sender });
     //    localStorage.setItem('chatMessages', JSON.stringify(messages));

     //    chatMessages.scrollTop = chatMessages.scrollHeight;
     //}

     function addMessageLink(alink, sender) {
         const alinkitem = document.createElement('a');
         alinkitem.classList.add('message', sender);
         alinkitem.href = alink;
         alinkitem.textContent = 'Bấm vào đây để đi đến';
         alinkitem.style.padding = '10px';
         alinkitem.style.color = 'blue';
         alinkitem.style.textAlign = 'center';
         chatMessages.appendChild(alinkitem);

         const messages = JSON.parse(localStorage.getItem('chatMessages')) || [];
         // Kiểm tra xem tin nhắn liên kết sắp được thêm có tồn tại trong mảng messages chưa
         const existingLinkIndex = messages.findIndex(msg => msg.type === 'link' && msg.link === alink && msg.sender === sender);

         // Nếu không tìm thấy tin nhắn liên kết tồn tại, thêm tin nhắn mới vào mảng
         if (existingLinkIndex === -1) {
             messages.push({ type: 'link', link: alink, sender: sender });
             localStorage.setItem('chatMessages', JSON.stringify(messages));
         }

         chatMessages.scrollTop = chatMessages.scrollHeight;
     }


     function sendMessage(value) {
         const message = value;
         if (message.trim() === '') return;

         addMessage(message, 'user');




         setTimeout(() => {

             $.ajax({
                 url: '/ChatBot/ChatBot?chat=' + message,

                 type: 'GET',
                 dataType: 'json',
                 success: function (data) {

                     if (data.message != null)
                         addMessage(data.message, 'bot');
                     if (data.imgsrc != null)
                         addMessageImg(data.imgsrc, 'bot');
                     if (data.alink != null)
                         addMessageLink(data.alink, 'bot');

                 },
                 error: function (xhr, status, error) {

                     addMessage("Lỗi khi gọi controller: " + error, 'bot');

                 }
             });
         }, 1000);
         userInput.value = '';

     }

     function getBotResponse(userMessage) {
         let botMessage = 'Xin lỗi, tôi không hiểu yêu cầu của bạn.';

         if (userMessage.toLowerCase().includes('xin chào')) {
             botMessage = 'Chào bạn! Tôi có thể giúp gì cho bạn hôm nay?';
         }
         else if (userMessage.toLowerCase().includes('giá')) {
             botMessage = 'Giá cả của chúng tôi thay đổi tùy thuộc vào sản phẩm. Vui lòng cho biết sản phẩm bạn quan tâm.';
         }
         else if (userMessage.toLowerCase().includes('giờ làm việc')) {
             botMessage = 'Chúng tôi làm việc từ 9h sáng đến 6h chiều, từ thứ Hai đến thứ Sáu.';
         }
         else if (userMessage.toLowerCase().includes('liên hệ')) {
             botMessage = 'Bạn có thể liên hệ với chúng tôi qua email support@example.com hoặc gọi điện thoại tới số (123) 456-7890.';
         }
         else if (userMessage.toLowerCase().includes('sản phẩm này còn không')) {
             botMessage = 'Sản phẩm này vẫn còn hàng.';
         }


         addMessage(botMessage, 'bot');
     }

     userInput.addEventListener('keypress', function (e) {
         if (e.key === 'Enter' && !e.shiftKey) {
             sendMessage(userInput.value);
             e.preventDefault(); // Prevent default form submission if necessary
         }
     });
     document.getElementById('clearChatButton').addEventListener('click', function () {
         // Xóa tất cả các tin nhắn hiện tại
         while (chatMessages.firstChild) {
             chatMessages.removeChild(chatMessages.firstChild);
         }

         // Xóa dữ liệu trong localStorage
         localStorage.removeItem('chatMessages');

         // Reset scroll position
         chatMessages.scrollTop = 0;
         document.getElementById('clearChatButton').style.display = 'none';
     });

 </script>
    </form>
</body>
</html>
